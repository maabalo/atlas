{
  "name": "atlas-viewer",
  "version": "1.0.0",
  "private": true,
  "description": "Atlas viewer checks. Node is only needed for these checks; Atlas itself runs with python3 atlas.py.",
  "scripts": {
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js && npm run format:check",
    "lint:html": "html-validate viewer/index.html tests/fixture/index.html",
    "lint:css": "stylelint \"viewer/*.css\"",
    "lint:js": "eslint viewer",
    "format": "prettier --write viewer",
    "format:check": "prettier --check viewer"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "html-validate": "11.16.2",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0"
  }
}
